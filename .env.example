# Copy this file to .env and adjust if needed: cp .env.example .env
# .env is gitignored. Never put real secrets in this file.

# Postgres from docker-compose.yml (user:password@host:port/database)
DATABASE_URL=postgresql://fm:fm@localhost:5432/fm

# Redis from docker-compose.yml (6380 on the Mac, because Homebrew Redis uses 6379)
REDIS_URL=redis://localhost:6380
