# development, test or production
NODE_ENV=development

# Port the API listens on
PORT=3000

# Postgres from docker-compose.yml (user:password@host:port/database)
DATABASE_URL=postgresql://fm:fm@localhost:5432/fm

# Redis from docker-compose.yml (6380 on the Mac, because Homebrew Redis uses 6379)
REDIS_URL=redis://localhost:6380

# FPL's public API. Must end with /. Only the fpl module (the worker) calls it.
FPL_BASE_URL=https://fantasy.premierleague.com/api/
